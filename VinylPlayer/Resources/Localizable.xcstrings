{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "  %@": {
      "comment": "A space between the album title and the artist name",
      "isCommentAutoGenerated": true
    },
    "%@ — %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — %2$@"
          }
        }
      }
    },
    "%@%@": {
      "comment": "A concatenation of the current text and the text of the current word, with the word's fill applied.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@"
          }
        }
      }
    },
    "%@%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$lld"
          }
        }
      }
    },
    "%lf": {},
    "%lld": {},
    "%lld / %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld albums": {},
    "%lld records": {},
    "%lld%%": {},
