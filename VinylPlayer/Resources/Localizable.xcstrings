    "album.delete_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove \"%@\" from your collection? This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をコレクションから削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컬렉션에서 \"%@\"을(를) 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要从收藏中移除 \"%@\" 吗？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要從收藏中移除 \"%@\" 嗎？此操作無法復原。"
          }
        }
      }
