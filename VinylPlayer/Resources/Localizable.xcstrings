    "backup.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your albums, artwork, lyrics, favorites, playlists and listening history. Audio files, sign-in credentials and app settings are not included."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出專輯、封面、歌詞、喜愛歌曲、播放清單及聆聽紀錄。不包含音訊檔案、登入資料及 app 設定。"
          }
        }
      }
    },
