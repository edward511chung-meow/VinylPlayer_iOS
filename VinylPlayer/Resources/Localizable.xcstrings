    "notification.neglected_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" by %2$@ hasn't been played in a while. Give it a spin?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の「%1$@」をしばらく聴いていません。もう一度聴いてみませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 \"%1$@\"을(를) 오랫동안 듣지 않았어요. 한번 들어볼까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@的《%1$@》已经很久没播放了，要不要听听？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@嘅《%1$@》已經好耐冇播過了，不如聽返？"
          }
        }
      }
    },
