    "metadata.local_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one album folder in Files. Reads embedded artwork/lyrics, cover.jpg, folder.jpg and UTF-8 .lrc files. Matches existing songs; does not import audio or modify source files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喺「檔案」選擇一個專輯資料夾。讀取內嵌封面／歌詞、cover.jpg、folder.jpg 同 UTF-8 .lrc，配對已有歌曲；唔會匯入音訊或修改原檔。"
          }
        }
      }
    },
