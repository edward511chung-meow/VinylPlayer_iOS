    "sleep.background_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown pauses playback while Vinyl Player is running. iOS may suspend the app in the background, delaying the pause until it resumes. Stop After This Song uses the Apple Music system queue and is available during Apple Music playback."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倒數會喺 Vinyl Player 運行時暫停播放。iOS 可能暫停背景 app，屆時要等 app 恢復先執行。「播完呢首停止」使用 Apple Music 系統待播清單，只適用於 Apple Music 播放。"
          }
        }
      }
    },
